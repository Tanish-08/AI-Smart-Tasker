# Backend application
APP_ENV=development
BIND_HOST=127.0.0.1
BIND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskmanager
DB_USER=taskmanager_user
DB_PASSWORD=CHANGE_ME
SQLITE_DATABASE_URL=sqlite:///:memory:

# OpenAI-compatible LLM endpoint (use EMPTY for local servers without auth)
LLM_MODEL_NAME=Qwen/Qwen3-VL-4B-Instruct
LLM_API_BASE=http://localhost:8001/v1
LLM_API_KEY=EMPTY

# Optional Gemini key for AI task categorisation
GEMINI_API_KEY=
